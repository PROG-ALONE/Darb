  {
   "id": "m12c4-p19",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "problem",
   "text": "احسب ∫_0^2 |x − 1| dx.",
   "ans": "1",
   "steps": [
    "نجزّئ عند x = 1: ∫_0^1 (1 − x) dx + ∫_1^2 (x − 1) dx",
    "= [x − x²/2]_0^1 + [x²/2 − x]_1^2",
    "= (1 − 0.5) + ((2 − 2) − (0.5 − 1))",
    "= 0.5 + 0.5 = 1"
   ],
   "ref": "177"
  },
  {
   "id": "m12c4-p20",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "problem",
   "text": "احسب ∫_0^{π/2} (x + cos x) dx.",
   "ans": "π²/8 + 1",
   "steps": [
    "= [x²/2 + sin x]_0^{π/2}",
    "= (π²/8 + 1) − (0 + 0)",
    "= π²/8 + 1"
   ],
   "ref": "177"
  },
  {
   "id": "m12c4-p21",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "problem",
   "text": "إذا كانت f(x) = 6 لكل x < 3 و f(x) = 2x لكل x ≥ 3 فأوجد ∫_0^4 f(x) dx.",
   "ans": "25",
   "steps": [
    "∫_0^4 f = ∫_0^3 6 dx + ∫_3^4 2x dx",
    "= [6x]_0^3 + [x²]_3^4",
    "= 18 + (16 − 9) = 18 + 7 = 25"
   ],
   "ref": "177"
  },
  {
   "id": "m12c4-q13",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "problem",
   "text": "إذا كان ∫_0^2 f(x) dx = 6 فأوجد ∫_0^2 4 f(x) dx.",
   "ans": "24",
   "steps": [
