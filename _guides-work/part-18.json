  },
  {
   "id": "m12c4-p15",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "problem",
   "text": "إذا كانت F(x) = 3x² دالة مقابلة لـ f على [1,5] فجد ∫_1^5 f(x) dx.",
   "ans": "72",
   "steps": [
