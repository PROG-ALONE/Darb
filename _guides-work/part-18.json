  {
   "id": "m12c4-p18",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "problem",
   "text": "احسب ∫_0^2 (x³ + 4x) dx.",
   "ans": "12",
   "steps": [
