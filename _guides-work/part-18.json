   ],
   "ref": ""
  },
  {
   "id": "m12c4-q14",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "problem",
   "text": "إذا كانت ∫_0^1 f₁(x) dx = 4 و ∫_0^1 f₂(x) dx = 9 فأوجد ∫_0^1 (2f₁(x) − f₂(x)) dx.",
   "ans": "−1",
   "steps": [
    "= 2∫f₁ − ∫f₂ = 2(4) − 9 = −1"
   ],
   "ref": ""
  },
  {
   "id": "m12c4-q15",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "problem",
   "text": "أوجد ∫_2^3 3x² dx بطريقتين (مباشرة وقلب الحدّين).",
   "ans": "19",
   "steps": [
    "مباشرة: [x³]_2^3 = 27 − 8 = 19",
    "بقلب الحدين: −∫_3^2 3x² dx = −[x³]_3^2 = −(8 − 27) = 19"
   ],
   "ref": ""
  },
  {
   "id": "m12c4t5:e0",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "example",
   "text": "إذا كان ∫_1^3 f(x) dx = 8 فأوجد ∫_1^3 5 f(x) dx.",
   "ans": "40",
   "steps": [
    "∫_1^3 5 f(x) dx = 5 ∫_1^3 f(x) dx",
