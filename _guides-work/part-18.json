  },
  {
   "id": "m12c4t5:e1",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "example",
   "text": "إذا كانت ∫_1^3 f₁(x) dx = 15 و ∫_1^3 f₂(x) dx = 17، فأوجد ∫_1^3 (f₁(x) + f₂(x)) dx و ∫_1^3 (f₁(x) − f₂(x)) dx.",
   "ans": "32 و −2",
   "steps": [
    "∫(f₁ + f₂) dx = ∫f₁ dx + ∫f₂ dx = 15 + 17 = 32",
    "∫(f₁ − f₂) dx = ∫f₁ dx − ∫f₂ dx = 15 − 17 = −2"
   ],
   "title": "مثال 4-5-10"
  },
  {
   "id": "m12c4t5:e2",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "example",
   "text": "إذا كانت f(x) = 3x² + 2x فأوجد ∫_1^2 f(x) dx.",
   "ans": "10",
   "steps": [
    "∫_1^2 (3x² + 2x) dx = ∫_1^2 3x² dx + ∫_1^2 2x dx",
