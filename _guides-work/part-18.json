   ],
   "ref": ""
  },
  {
   "id": "m12c4-q11",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "problem",
   "text": "جد ∫_1^4 (x + 1) dx.",
   "ans": "10.5",
   "steps": [
    "= [x²/2 + x]_1^4",
    "= (8 + 4) − (0.5 + 1)",
    "= 12 − 1.5 = 10.5"
   ],
   "ref": ""
  },
  {
   "id": "m12c4-q12",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "problem",
   "text": "جد ∫_0^1 (3x² + 2x) dx.",
   "ans": "2",
   "steps": [
    "= [x³ + x²]_0^1 = (1 + 1) − 0 = 2"
   ],
   "ref": ""
  },
  {
   "id": "m12c4t4:e0",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "example",
   "text": "إذا كانت f(x) دالة مستمرة على الفترة [1,5] بحيث F(x) = 3x² دالة مقابلة للدالة f، فجد ∫_1^5 f(x) dx.",
   "ans": "72",
   "steps": [
    "∫_1^5 f(x) dx = F(5) − F(1)",
    "= 3(25) − 3(1)",
    "= 75 − 3 = 72"
   ],
   "title": "مثال 4-4-1"
  },
  {
   "id": "m12c4t4:e1",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "example",
   "text": "إذا كانت f دالة مستمرة على الفترة [0, π/2] وإن الدالة المقابلة لها هي F(x) = sin x، فأوجد ∫_0^{π/2} f(x) dx.",
   "ans": "1",
   "steps": [
    "∫_0^{π/2} f(x) dx = F(π/2) − F(0)",
    "= sin(π/2) − sin 0",
    "= 1 − 0 = 1"
   ],
   "title": "مثال 4-4-2"
  },
  {
   "id": "m12c4t4:e2",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "example",
   "text": "أثبت أن F : [1,3] → R, F(x) = x³ + 2 هي دالة مقابلة للدالة f(x) = 3x².",
   "ans": "F دالة مقابلة لـ f",
   "steps": [
    "F كثيرة حدود فهي مستمرة على [1,3] وقابلة للاشتقاق على (1,3)",
    "F′(x) = 3x² = f(x) لكل x ∈ (1,3)",
    "إذن F دالة مقابلة للدالة f على [1,3]"
   ],
   "title": "مثال 4-4-3"
  },
  {
   "id": "m12c4t4:e3",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "example",
   "text": "أثبت أن F : R → R, F(x) = ½ sin 2x هي دالة مقابلة للدالة f : R → R, f(x) = cos 2x، ثم أوجد ∫_0^{π/2} cos 2x dx.",
   "ans": "0",
   "steps": [
    "F′(x) = ½ (cos 2x)(2) = cos 2x = f(x) لكل x ∈ R",
    "إذن F دالة مقابلة لـ f",
    "∫_0^{π/2} cos 2x dx = [½ sin 2x]_0^{π/2}",
    "= ½(sin π − sin 0) = ½(0 − 0) = 0"
   ],
   "title": "مثال 4-4-4"
  },
  {
   "id": "m12c4t4:e4",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "example",
   "text": "أوجد ∫_0^{π/4} sec²x dx.",
   "ans": "1",
   "steps": [
    "∫_0^{π/4} sec²x dx = [tan x]_0^{π/4}",
    "= tan(π/4) − tan 0",
    "= 1 − 0 = 1"
   ],
   "title": "مثال 4-4-5"
  },
  {
   "id": "m12c4t4:e5",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "example",
   "text": "أوجد ∫_{π/4}^{π/2} csc²x dx.",
   "ans": "1",
   "steps": [
    "∫_{π/4}^{π/2} csc²x dx = [−cot x]_{π/4}^{π/2}",
    "= −cot(π/2) + cot(π/4)",
    "= 0 + 1 = 1"
   ],
   "title": "مثال 4-4-6"
  },
  {
   "id": "m12c4t4:e6",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "example",
   "text": "أوجد ∫_0^{π/3} sec x tan x dx.",
   "ans": "1",
   "steps": [
    "∫_0^{π/3} sec x tan x dx = [sec x]_0^{π/3}",
    "= sec(π/3) − sec 0",
    "= 2 − 1 = 1"
   ],
   "title": "مثال 4-4-7"
  },
  {
   "id": "m12c4t4:e7",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "example",
   "text": "جد ∫_1^3 x³ dx.",
   "ans": "20",
   "steps": [
    "∫_1^3 x³ dx = [x⁴/4]_1^3",
    "= 81/4 − 1/4",
    "= 80/4 = 20"
   ],
   "title": "مثال 4-4-8"
  },
  {
   "id": "m12c4-p16",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "problem",
   "text": "احسب ∫_1^3 (3x − 2) dx.",
