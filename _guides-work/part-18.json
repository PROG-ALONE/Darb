  },
  {
   "id": "m12c4t5:e3",
   "subj": "الرياضيات",
   "key": "12:sci:الرياضيات",
   "ch": "a12c4",
   "chName": "الفصل الرابع: التكامل",
   "kind": "example",
   "text": "إذا كانت ∫_1^2 f(x) dx = 5 و ∫_2^3 f(x) dx = 8 فأوجد ∫_1^3 f(x) dx.",
   "ans": "13",
   "steps": [
